{
  "name": "xgoose-extension-chrome",
  "version": "0.4.2",
  "private": true,
  "description": "Chrome MV3 host for the xgoose agent, built on top of @xgoose/core, @xgoose/page-controller, and @xgoose/ui.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "node scripts/build.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "e2e:sites": "node scripts/e2e-sites.mjs",
    "e2e:dynamic": "node scripts/e2e-dynamic-skill.mjs"
  },
  "dependencies": {
    "@xgoose/core": "0.2.0",
    "@xgoose/page-controller": "0.2.0",
    "@xgoose/skill-runtime": "0.2.0",
    "@xgoose/ui": "0.2.0",
    "parse5": "^8.0.1",
    "webext-patterns": "^1.3.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.0.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
