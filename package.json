{
  "name": "xgoose",
  "version": "0.2.0",
  "private": true,
  "description": "Headless agent + DOM page controller + chat UI for xgoose (factored out of xgoose-safari so the same code can host Chrome / Firefox / userscript-style extensions).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w xgoose-extension-chrome",
    "typecheck": "tsc -p apps/chrome/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "npm run build && node tests/browser/acceptance.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module"
}
